{
  "latex-workshop.latex.outDir": "%DIR%/build",
  "latex-workshop.latex.tools": [
    {
      "name": "latexmk-rc",
      "command": "latexmk",
      "args": ["-interaction=nonstopmode", "-file-line-error", "-outdir=%OUTDIR%", "%DOC%"]
    }
  ],
  "latex-workshop.latex.recipes": [
    { "name": "latexmk (uplatex, build/)", "tools": ["latexmk-rc"] }
  ],
  "latex-workshop.latex.recipe.default": "first"
}