% Terrain Deformation Research: annotated literature map
% Search date: 2026-11-06
% Scope: real-time surface deformation, layered material representations,
% sparse persistent terrain, and calibration of reduced models.
% This is a focused literature map, not an exhaustive systematic review.
% Annotations are review summaries, not copied author abstracts.
% Timing classifications refer to reported workloads, not a verified 3 ms budget.
% Paper A: layered real-time deformation. Paper B: sparse persistent architecture.
% Paper C: parameter inference from high-fidelity numerical references.
% Foundational and offline references are explicitly labeled.
% Use journal publication years; annotations note relevant earlier versions.

@article{Onoue2005AnInteractiveDeformation,
  title = {{An Interactive Deformation System for Granular Material}},
  author = {Koichi Onoue and Tomoyuki Nishita},
  year = {2005},
  journal = {Computer Graphics Forum 24(1), 51–60},
  doi = {10.1111/j.1467-8659.2005.00828.x},
  url = {https://diglib.eg.org/items/1d8393a9-11d9-4bd5-bdf2-b24cfa0b5630},
  urldate = {2026-11-06},
  keywords = {Terrain Deformation Research, Paper A, interactive},
  annote = {Review classification: interactive. Handles object–granular-ground collision, material displacement and erosion of steep slopes. A Height Span Map supports arbitrary, including concave, object shapes, while texture sliding conveys granular motion.}
}

@inproceedings{Aquilio2006RealTimeGPU,
