}

@inproceedings{Holz2009SoilDeformationModels,
  title = {{Soil Deformation Models for Real-Time Simulation: A Hybrid Approach}},
  author = {Daniel Holz and Thomas Beer and Torsten Kuhlen},
  year = {2009},
  booktitle = {VRIPHYS 2009: Virtual Reality Interactions and Physical Simulations, 21–30},
  doi = {10.2312/PE/vriphys/vriphys09/021-030},
