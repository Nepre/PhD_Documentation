  keywords = {Terrain Deformation Research, Paper A, real-time claim},
  annote = {Review classification: real-time claim. Modifies terramechanics for visually plausible off-road vehicle terrain deformation. It accounts for vehicle load, velocity, tire size and soil concentration, producing vertical compression and lateral displacement.}
}

@inproceedings{Chen2013RealTimeSimulation,
